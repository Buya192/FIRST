# PLN Marketplace Scraper Environment Configuration
# Copy this file to .env and fill in your actual values

# PLN Marketplace Credentials
PLN_USERNAME=your_username_here
PLN_PASSWORD=your_password_here
PLN_MARKETPLACE_URL=https://marketplace.pln.co.id

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=config/firebase-credentials.json

# Scraping Configuration
SCRAPING_INTERVAL_MINUTES=30
MAX_RETRY_ATTEMPTS=3
REQUEST_TIMEOUT_SECONDS=30
PAGE_LOAD_TIMEOUT_SECONDS=60

# Browser Configuration
HEADLESS_BROWSER=true
BROWSER_WINDOW_WIDTH=1920
BROWSER_WINDOW_HEIGHT=1080
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/scraper.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# Sync Configuration
ENABLE_BIDIRECTIONAL_SYNC=true
SYNC_BATCH_SIZE=100
CONFLICT_RESOLUTION_STRATEGY=marketplace_wins

# Rate Limiting
REQUESTS_PER_MINUTE=60
CONCURRENT_REQUESTS=5

# Monitoring & Alerts (Optional)
ENABLE_SENTRY=false
SENTRY_DSN=
SLACK_WEBHOOK_URL=
EMAIL_ALERTS_ENABLED=false

# Development Settings
DEBUG_MODE=false
SAVE_SCREENSHOTS=true
SCREENSHOT_PATH=screenshots
