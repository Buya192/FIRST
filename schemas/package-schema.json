{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Package",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the package."
    },
    "version": {
      "type": "string",
      "description": "Version of the package"
    },
    "description": {
      "type": "string",
      "description": "Description of the package"
    },
    "private": {
      "type": "boolean",
      "description": "Prevents the package from being accidentally published on npm"
    },
    "type": {
      "type": "string",
      "description": "Module system used (e.g., 'module' for ES modules)"
    },
    "scripts": {
      "type": "object",
      "description": "Scripts that can be run using npm run"
    },
    "dependencies": {
      "type": "object",
      "description": "Production dependencies"
    },
    "devDependencies": {
      "type": "object",
      "description": "Development dependencies"
    },
    "resolutions": {
      "type": "object",
      "description": "Package version resolutions"
    }
  }
}