rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /wo-photos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /transaksi/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /transaksiMasuk/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
